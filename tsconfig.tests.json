{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": ".cache/tsconfig.tests.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM",
      "WebWorker"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules/**",
    "dist/**"
  ]
}
