{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genericagent.local/schemas/D2_bridge_command_schema.json",
  "title": "GA/TMWD Browser Pro D2 bridge command schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "cmd",
    "tabId"
  ],
  "properties": {
    "cmd": {
      "type": "string",
      "enum": [
        "browser_pro.install",
        "browser_pro.collect",
        "browser_pro.clear_buffer",
        "browser_pro.status",
        "browser_pro.uninstall",
        "browser_pro.pause",
        "browser_pro.resume",
        "browser_pro.evaluate",
        "browser_pro.html",
        "browser_pro.screenshot",
        "browser_pro.frames",
        "browser_pro.evaluate_frame",
        "browser_pro.add_new_document_script",
        "browser_pro.remove_new_document_script",
        "browser_pro.navigate",
        "browser_pro.navigateAndWait",
        "browser_pro.waitForNavigation",
        "browser_pro.waitForLoadState",
        "browser_pro.waitForNetworkIdle",
        "browser_pro.waitForSelector",
        "browser_pro.waitForAny",
        "browser_pro.waitForAll",
        "browser_pro.cancelWait",
        "browser_pro.addEventListener",
        "browser_pro.removeEventListener",
        "browser_pro.getPerformanceEntries",
        "browser_pro.diagnose",
        "browser_pro.network.start",
        "browser_pro.network.stop",
        "browser_pro.network.status",
        "browser_pro.network.clear",
        "browser_pro.network.list",
        "browser_pro.network.get",
        "browser_pro.network.body",
        "browser_pro.network.exportHar",
        "browser_pro.network.wait"
      ],
      "description": "Canonical Browser Pro bridge command. browser_pro.navigate starts navigation only; use browser_pro.navigateAndWait or browser_pro.waitFor* for lifecycle completion."
    },
    "tabId": {
      "type": "integer",
      "minimum": 0
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "Logical Browser Pro session id; used to isolate queues, waits, and diagnostics."
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "boolean"
        },
        "dom": {
          "type": "boolean"
        },
        "console": {
          "type": "boolean"
        },
        "error": {
          "type": "boolean"
        },
        "xpath": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cookies": {
          "type": "boolean"
        },
        "storage": {
          "type": "boolean"
        },
        "websocket": {
          "type": "boolean"
        },
        "crypto": {
          "type": "boolean"
        },
        "dom_sinks": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    },
    "force": {
      "type": "boolean",
      "description": "For browser_pro.install, replace an active Browser Pro session even when a dispatcher is already installed."
    },
    "expected_version": {
      "type": "string",
      "description": "Optional dispatcher version expected by the caller during browser_pro.install."
    },
    "install_fingerprint": {
      "type": "string",
      "description": "Stable fingerprint for the requested session targets/options, used to distinguish safe idempotency from stale Browser Pro reuse."
    },
    "expression": {
      "type": "string"
    },
    "frameId": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "identifier": {
      "type": "string"
    },
    "sessionId": {
      "type": "string",
      "description": "Camel-case alias for session_id, used by browser_pro.network.* recorder sessions."
    },
    "maxEntries": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum per-recorder request entries kept in the ring buffer."
    },
    "max_entries": {
      "type": "integer",
      "minimum": 1,
      "description": "Legacy alias for maxEntries."
    },
    "maxAgeMs": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum age for network recorder entries before pruning."
    },
    "max_age_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Legacy alias for maxAgeMs."
    },
    "maxBodyBytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum stored response body bytes for browser_pro.network body capture."
    },
    "max_body_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Legacy alias for maxBodyBytes."
    },
    "maxPostDataBytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum request postData bytes retained when captureRequestPostData is true."
    },
    "max_post_data_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Legacy alias for maxPostDataBytes."
    },
    "maxFrames": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum WebSocket frames stored per request."
    },
    "max_frame_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum WebSocket or SSE payload bytes retained per event."
    },
    "maxSseEvents": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum SSE events stored per EventSource request."
    },
    "max_sse_events": {
      "type": "integer",
      "minimum": 0,
      "description": "Legacy alias for maxSseEvents."
    },
    "captureBodies": {
      "type": "boolean",
      "description": "When true, capture response bodies after Network.loadingFinished through Network.getResponseBody."
    },
    "capture_bodies": {
      "type": "boolean",
      "description": "Legacy alias for captureBodies."
    },
    "captureRequestPostData": {
      "type": "boolean",
      "description": "When true, retain bounded request postData from Network.requestWillBeSent."
    },
    "capture_request_post_data": {
      "type": "boolean",
      "description": "Legacy alias for captureRequestPostData."
    },
    "includeWebSocketFrames": {
      "type": "boolean",
      "description": "When false, suppress WebSocket frame payload capture."
    },
    "include_websocket_frames": {
      "type": "boolean",
      "description": "Legacy alias for includeWebSocketFrames."
    },
    "includeSse": {
      "type": "boolean",
      "description": "When false, suppress SSE event capture."
    },
    "include_sse": {
      "type": "boolean",
      "description": "Legacy alias for includeSse."
    },
    "bodyTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "description": "Timeout for Network.getResponseBody calls."
    },
    "body_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "description": "Legacy alias for bodyTimeoutMs."
    },
    "includeUrls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URL include filters used by browser_pro.network start/list/export/wait."
    },
    "include_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy alias for includeUrls."
    },
    "excludeUrls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URL exclude filters used by browser_pro.network start/list/export/wait."
    },
    "exclude_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy alias for excludeUrls."
    },
    "resourceTypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CDP resource type filters for the network recorder."
    },
    "resource_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy alias for resourceTypes."
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "HTTP method filters for the network recorder."
    },
    "method": {
      "type": "string",
      "description": "Single HTTP method filter for browser_pro.network list/export/wait."
    },
    "type": {
      "type": "string",
      "description": "Network resource type filter for browser_pro.network list/export/wait."
    },
    "status": {
      "type": "integer",
      "description": "Single HTTP status filter for browser_pro.network list/export/wait."
    },
    "statuses": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "HTTP status filters for body capture."
    },
    "condition": {
      "type": "string",
      "description": "browser_pro.network.wait condition: request, response, body, finished, failed, websocket/wsFrame, sse/sseEvent, count, idle, or any."
    },
    "bodyRef": {
      "type": "string",
      "description": "Stored response body reference returned by browser_pro.network.get/list/export."
    },
    "body_ref": {
      "type": "string",
      "description": "Legacy alias for bodyRef."
    },
    "bodyContains": {
      "type": "string",
      "description": "browser_pro.network.wait body substring or regex-style filter."
    },
    "body_contains": {
      "type": "string",
      "description": "Legacy alias for bodyContains."
    },
    "wsFrame": {
      "description": "browser_pro.network.wait WebSocket frame criterion: string or object with method/opcode/payloadContains."
    },
    "ws_frame": {
      "description": "Legacy alias for wsFrame."
    },
    "sseEvent": {
      "description": "browser_pro.network.wait SSE criterion: string or object with eventName/eventId/dataContains."
    },
    "sse_event": {
      "description": "Legacy alias for sseEvent."
    },
    "mime": {
      "type": "string",
      "description": "MIME/content-type filter for browser_pro.network list/export/wait."
    },
    "mimeType": {
      "type": "string",
      "description": "Camel-case alias for MIME filter."
    },
    "mime_type": {
      "type": "string",
      "description": "Legacy alias for MIME filter."
    },
    "includeBody": {
      "type": "boolean",
      "description": "Include stored body payloads in browser_pro.network.get/exportHar responses."
    },
    "include_body": {
      "type": "boolean",
      "description": "Legacy alias for includeBody."
    },
    "includeBodies": {
      "type": "boolean",
      "description": "Alias for includeBody on browser_pro.network.exportHar."
    },
    "include_bodies": {
      "type": "boolean",
      "description": "Legacy alias for includeBodies."
    },
    "includeDetails": {
      "type": "boolean",
      "description": "Include full request record details in browser_pro.network.list responses."
    },
    "include_details": {
      "type": "boolean",
      "description": "Legacy alias for includeDetails."
    },
    "format": {
      "type": "string",
      "description": "browser_pro.network.exportHar output format: HAR 1.2 envelope by default, or json for internal structured export."
    },
    "keepBuffer": {
      "type": "boolean",
      "description": "browser_pro.network.stop option: keep request/body buffers after stopping the recorder."
    },
    "keep_buffer": {
      "type": "boolean",
      "description": "Legacy alias for keepBuffer."
    },
    "clear": {
      "type": "boolean",
      "description": "browser_pro.network.start clears on start unless false; browser_pro.network.stop clears buffers when true."
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "description": "Minimum matching request count for browser_pro.network.wait condition=count."
    },
    "since_seq": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 0
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "description": "Pagination offset for browser_pro.network.list."
    },
    "event_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "url": {
      "type": "string",
      "description": "Target/navigation URL or URL filter depending on command."
    },
    "waitUntil": {
      "type": "string",
      "description": "Navigation/lifecycle target such as load, domcontentloaded, networkidle, selector, or complete."
    },
    "state": {
      "type": "string",
      "description": "Load/document readiness state, e.g. loading, interactive, complete."
    },
    "selector": {
      "type": "string",
      "description": "CSS selector used by selector waits, event subscriptions, or browser_pro.html extraction."
    },
    "mode": {
      "type": "string",
      "enum": [
        "outer",
        "inner",
        "text",
        "textContent",
        "text_content"
      ],
      "description": "browser_pro.html extraction mode: outerHTML, innerHTML, or textContent."
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum UTF-8 bytes returned by browser_pro.html before truncation."
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Legacy alias for maxBytes."
    },
    "maxChars": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum JavaScript string characters returned by browser_pro.html before truncation."
    },
    "max_chars": {
      "type": "integer",
      "minimum": 0,
      "description": "Legacy alias for maxChars."
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "description": "Per-command timeout in milliseconds."
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "description": "Legacy alias for timeoutMs."
    },
    "idleMs": {
      "type": "integer",
      "minimum": 1,
      "description": "Required quiet window for network-idle waits."
    },
    "idle_ms": {
      "type": "integer",
      "minimum": 1,
      "description": "Legacy alias for idleMs."
    },
    "pollMs": {
      "type": "integer",
      "minimum": 1,
      "description": "DOM selector polling interval."
    },
    "poll_ms": {
      "type": "integer",
      "minimum": 1,
      "description": "Legacy alias for pollMs."
    },
    "visible": {
      "type": "boolean",
      "description": "When true, selector wait also requires a visible element."
    },
    "waitId": {
      "type": "string",
      "description": "Identifier for a pending wait; omitted browser_pro.cancelWait cancels all pending waits in scope."
    },
    "wait_id": {
      "type": "string",
      "description": "Legacy alias for waitId."
    },
    "waits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/waitCondition"
      },
      "description": "Child D2 wait condition objects for browser_pro.waitForAny and browser_pro.waitForAll; the bridge owns cancellation/cleanup of child waits after resolve, timeout, or cancel."
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/waitCondition"
      },
      "description": "Legacy alias for waits."
    },
    "requestId": {
      "type": "string",
      "description": "Request/correlation id for waits, subscriptions, and diagnostics."
    },
    "request_id": {
      "type": "string",
      "description": "Legacy alias for requestId."
    },
    "diagnostics": {
      "type": [
        "boolean",
        "object"
      ],
      "description": "Request or return diagnostics for active waits, subscriptions, inflight network, frame tree, and CDP state."
    },
    "sameDocument": {
      "type": "boolean",
      "description": "Whether browser_pro.waitForNavigation may resolve for same-document/hash/history navigation."
    },
    "targetUrl": {
      "type": "string",
      "description": "Resolved/current target URL reported by wait/navigation commands."
    },
    "eventType": {
      "type": "string",
      "description": "DOM/page event type for browser_pro.addEventListener."
    },
    "listenerId": {
      "type": "string",
      "description": "Subscription id returned by browser_pro.addEventListener and consumed by browser_pro.removeEventListener."
    },
    "entryType": {
      "type": "string",
      "description": "PerformanceEntry type filter, e.g. navigation, resource, paint."
    },
    "nameContains": {
      "type": "string",
      "description": "Substring filter for PerformanceEntry name."
    },
    "maxInflight": {
      "type": "integer",
      "description": "Maximum inflight network requests allowed during network-idle waits.",
      "minimum": 0
    },
    "error_code": {
      "type": "string",
      "description": "D2 error code. Wait/event commands use specific timeout/cancel/frame/tab/subscription codes rather than generic INTERNAL_ERROR.",
      "enum": [
        "NO_SESSION",
        "UNSUPPORTED_TARGET",
        "INJECTION_FAILED",
        "SAFETY_BLOCKED",
        "BUFFER_OVERFLOW",
        "ALREADY_INSTALLED",
        "NOT_INSTALLED",
        "INVALID_RULE",
        "TIMEOUT",
        "NAVIGATION_TIMEOUT",
        "SELECTOR_TIMEOUT",
        "NETWORK_IDLE_TIMEOUT",
        "NETWORK_RECORDER_NOT_STARTED",
        "NETWORK_RECORDER_TIMEOUT",
        "BODY_UNAVAILABLE",
        "FRAME_DETACHED",
        "CROSS_ORIGIN_IFRAME",
        "TAB_CRASHED",
        "BACKGROUND_THROTTLED",
        "EVENT_SUBSCRIPTION_FAILED",
        "CANCELLED",
        "INTERNAL_ERROR"
      ]
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "enum": [
            "network",
            "dom",
            "console",
            "error",
            "xpath",
            "cookies",
            "storage",
            "websocket",
            "crypto",
            "dom_sinks",
            "custom"
          ]
        },
        "operation": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "match": {
          "type": "object",
          "additionalProperties": true
        },
        "capture": {
          "type": "object",
          "additionalProperties": true
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "ok",
            "data"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "data": {
              "anyOf": [
                {},
                {
                  "$ref": "#/$defs/waitSuccessData"
                }
              ]
            }
          },
          "description": "D2 success envelope. data may be event collections, frame lists, script identifiers, wait success data, or diagnostics."
        },
        {
          "type": "object",
          "required": [
            "ok",
            "error_code",
            "error",
            "details"
          ],
          "properties": {
            "ok": {
              "const": false
            },
            "error_code": {
              "type": "string"
            },
            "error": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "diagnostics": {
                  "$ref": "#/$defs/diagnostics"
                },
                "request_id": {
                  "type": "string"
                },
                "wait_id": {
                  "type": "string"
                }
              }
            }
          },
          "description": "D2 failure envelope. details preserves Chrome/debugger errors and wait diagnostics instead of returning legacy non-D2 error objects."
        }
      ]
    },
    "waitCondition": {
      "type": "object",
      "additionalProperties": true,
      "description": "Composable child wait for browser_pro.waitForAny/browser_pro.waitForAll. The bridge accepts canonical wait command objects and normalizes cleanup/cancellation for losing or failed branches.",
      "properties": {
        "cmd": {
          "type": "string",
          "description": "Child wait command, e.g. browser_pro.waitForSelector, browser_pro.waitForNetworkIdle, browser_pro.waitForLoadState, browser_pro.waitForNavigation."
        },
        "selector": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "state": {
          "type": "string"
        },
        "waitUntil": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "idleMs": {
          "type": "integer",
          "minimum": 1
        },
        "pollMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxInflight": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string"
        },
        "sameDocument": {
          "type": "boolean"
        },
        "requestId": {
          "type": "string"
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "description": "Diagnostic snapshot for sessions, active waits, subscriptions, inflight network state, frame tree, CDP availability, and cleanup/recovery state."
    },
    "waitSuccessData": {
      "type": "object",
      "additionalProperties": true,
      "description": "Allowed data fields for navigation/wait/event commands.",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "wait_id": {
          "type": "string"
        },
        "listener_id": {
          "type": "string"
        },
        "elapsed_ms": {
          "type": "number"
        },
        "tab_id": {
          "type": "integer"
        },
        "frame_id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "targetUrl": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "dispatcher_version": {
          "type": "string"
        },
        "install_epoch": {
          "type": "number"
        },
        "owner_session_id": {
          "type": "string"
        },
        "install_fingerprint": {
          "type": "string"
        },
        "installed_marker": {
          "type": "boolean"
        },
        "cleanup_warnings": {
          "type": "array"
        },
        "residue_signatures": {
          "type": "array"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        },
        "entries": {
          "type": "array"
        },
        "event": {
          "type": "object",
          "additionalProperties": true
        },
        "winner": {
          "type": "object",
          "additionalProperties": true
        },
        "results": {
          "type": "array"
        }
      }
    }
  },
  "description": "Command/response schema for GA/TMWD Browser Pro D2 bridge including Browser Pro lifecycle, persistent CDP iframe helpers, wait orchestration, event subscriptions, performance entries, and diagnostics."
}
