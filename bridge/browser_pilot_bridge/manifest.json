{
  "manifest_version": 3,
  "name": "Browser Pilot Bridge",
  "short_name": "Browser Pilot",
  "version": "0.4.0",
  "version_name": "0.4.0-browser-pilot",
  "description": "Browser Pilot browser tools bridge",
  "key": "",
  "permissions": [
    "cookies",
    "tabs",
    "activeTab",
    "debugger",
    "scripting",
    "alarms",
    "management",
    "contentSettings",
    "downloads",
    "webNavigation",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
