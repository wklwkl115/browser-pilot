{
  "$id": "pi-browser-tools-browser-workflow-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evalId",
    "status",
    "toolCallCount",
    "firstWrongToolChoice",
    "recoveredAfterFailure",
    "artifactSufficiency",
    "scopedFollowUpDiscipline",
    "evidence",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evalId": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$" },
    "status": { "enum": ["not-run", "passed", "failed", "blocked"] },
    "toolCallCount": { "type": "integer", "minimum": 0 },
    "firstWrongToolChoice": { "type": ["string", "null"] },
    "recoveredAfterFailure": { "type": "boolean" },
    "artifactSufficiency": { "enum": ["not-evaluated", "sufficient", "insufficient", "not-needed"] },
    "scopedFollowUpDiscipline": { "enum": ["not-evaluated", "passed", "failed", "not-applicable"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "artifacts", "diagnostics"],
      "properties": {
        "summary": { "type": "array", "items": { "type": "string" } },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "diagnostics": { "type": "array", "items": { "type": "string" } }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
