{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
		"module": "Node20",
    "moduleResolution": "Node16",
    "incremental": true,
    "tsBuildInfoFile": ".cache/tsconfig.build.tsbuildinfo",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "src/bridge/extension/**",
    "tests/**",
    "node_modules/**",
    "dist/**"
  ]
}
