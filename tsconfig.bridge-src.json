{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "WebWorker"]
  },
  "include": [
    "bridge_src/**/*.ts",
    "bridge/pi_browser_bridge/bridge-globals.d.ts"
  ]
}
