{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": ".cache/tsconfig.typecheck.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "src/bridge/extension/**",
    "tests/**",
    "node_modules/**"
  ]
}
