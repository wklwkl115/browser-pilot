{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleDetection": "legacy",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "skipLibCheck": true
  },
  "include": [
    "bridge/pi_browser_bridge/*.js",
    "bridge/pi_browser_bridge/bridge-globals.d.ts"
  ]
}
