      },
      "sessionId": {
        "type": "string"
      },
      "timeoutMs": {
        "type": "integer"
      }
    },
    "additionalProperties": true
  },
  "aliases": {
    "hook.clear": "hook.clear_buffer",
    "hook.ping": "hook.status"
  },
