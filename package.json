{
  "name": "browser-pilot",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "description": "Agent-driven browser automation: a Chrome extension + Node bridge exposing 22 browser_* tools for scanning, execution, evidence capture, and web-security testing.",
  "keywords": [
    "browser-pilot",
    "browser-automation",
    "chrome-extension",
    "cdp",
    "devtools-protocol",
    "web-scraping",
    "dom",
    "web-security",
    "agent-tools",
    "ai-agent",
    "ai-tools",
    "browser-testing",
    "pentesting"
  ],
  "author": "Wang-ke-li",
  "homepage": "https://github.com/wklwkl115/browser-pilot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wklwkl115/browser-pilot.git"
  },
  "bugs": {
    "url": "https://github.com/wklwkl115/browser-pilot/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "browser-pilot": "./dist/cli/bin.js"
  },
  "scripts": {
    "sync:protocol": "node scripts/sync-native-protocol.mjs",
    "sync:capture": "node scripts/sync-capture.mjs",
    "sync:config": "node scripts/sync-bridge-config.mjs",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json",
    "build:bridge": "node scripts/build-bridge.mjs",
    "prepare": "tsc -p tsconfig.build.json && node scripts/build-bridge.mjs --quiet",
    "cli": "tsx cli/bin.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && node scripts/verify-boundaries.mjs",
    "lint:fix": "eslint . --fix",
    "report:boundaries": "node scripts/architecture-boundary-report.mjs",
    "verify:pairing": "node scripts/verify-pairing.mjs",
    "contract:record": "node scripts/contracts.mjs record",
    "contract:verify": "node scripts/contracts.mjs verify",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm run build:bridge && npm run contract:verify && npm run verify:package && npm run verify:pairing",
    "quality:local": "npm run check",
    "prepack": "npm run build && node scripts/build-bridge.mjs --quiet",
    "verify:package": "node scripts/verify-public-package.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "typebox": "^1.0.55",
    "typescript": "^6.0.3",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "typebox": "^1.0.55"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.4",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "tsx": "^4.22.3",
    "typescript-eslint": "^8.60.0"
  },
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "SECURITY.md",
    "bridge/",
    "src/bridge/extension/",
    "capture-src/",
    "docs/browser-memory.md",
    "docs/browser-usage.md",
    "docs/cli.md",
    "docs/guide-cli.md",
    "docs/generated/browser-tool-reference.generated.md",
    "docs/generated/native-protocol.generated.md",
    "docs/playbooks/",
    "docs/reference/",
    "docs/tool-boundaries.md",
    "scripts/architecture-boundary-*.mjs",
    "scripts/import-graph.mjs",
    "scripts/build-bridge.mjs",
    "scripts/clean-build.mjs",
    "scripts/sync-bridge-config.mjs",
    "scripts/sync-capture.mjs",
    "scripts/sync-native-protocol.mjs",
    "scripts/verify-public-package.mjs",
    "skills/browser-pilot-cli/",
    "cli/",
    "src/",
    "dist/",
    "tsconfig.json",
    "tsconfig.base.json",
    "tsconfig.build.json",
    "tsconfig.bridge-src.json"
  ]
}
