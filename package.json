{
  "name": "pi-browser-tools",
  "version": "0.3.0",
  "private": true,
  "description": "Native Pi browser automation tools backed by the Pi Browser Bridge.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "browser-automation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "pi-browser": "./dist/cli/bin.js"
  },
  "scripts": {
    "sync:protocol": "node scripts/sync-native-protocol.mjs",
    "sync:config": "node scripts/sync-bridge-config.mjs",
    "docs:generate": "node scripts/generate-tool-docs.mjs",
    "docs:sync-indexes": "node scripts/sync-doc-indexes.mjs",
    "prepare": "lefthook install",
    "build": "tsc -p tsconfig.build.json",
    "build:bridge": "node scripts/build-bridge.mjs",
    "cli": "tsx cli/bin.ts",
    "smoke:cli": "tsx tests/smoke/smoke-cli.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:all": "node scripts/run-check-groups.mjs",
    "check:all:bridge": "node scripts/run-check-groups.mjs bridge unit",
    "check:src:types": "tsc -p tsconfig.json",
    "check:all:package": "node scripts/run-check-groups.mjs package docs",
    "check:all:contracts": "node scripts/run-check-groups.mjs contracts",
    "check:lint": "node tests/contracts/drift/check-boundaries.mjs && node tests/contracts/protocol/check-bridge-files.mjs && tsx tests/contracts/runtime/check-page-scripts.mjs",
    "verify:bridge:dist": "node tests/contracts/protocol/check-bridge-build.mjs",
    "check:bridge:files": "node tests/contracts/protocol/check-bridge-files.mjs",
    "check:bridge:build": "npm run verify:bridge:dist",
    "check:bridge:types": "tsc -p tsconfig.bridge-src.json",
    "check:protocol": "node scripts/sync-native-protocol.mjs --check && node tests/contracts/protocol/check-protocol-contract.mjs",
    "check:tools": "node tests/contracts/tools/check-tools-contract.mjs && tsx tests/contracts/tools/check-execute-tool.mjs",
    "check:pi-browser-bridge": "node tests/contracts/protocol/check-pi-browser-bridge.mjs",
    "check:tool-docs": "node tests/contracts/drift/check-tool-doc-drift.mjs && node scripts/generate-tool-docs.mjs --check",
    "check:doc-structure": "node tests/contracts/drift/check-doc-structure.mjs",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --import tsx tests/unit/**/*.test.ts",
    "check:bridge": "npm run check:bridge:types && npm run check:bridge:build && npm run check:bridge:files && npm run check:protocol && npm run check:tools",
    "check:registry-drift": "node tests/contracts/drift/check-registry-drift.mjs",
    "check:scan": "tsx tests/contracts/runtime/check-scan-script.mjs",
    "check:content-pick": "tsx tests/contracts/runtime/check-content-pick.mjs",
    "check:transfer": "tsx tests/contracts/tools/check-transfer-tools.mjs && tsx tests/contracts/runtime/check-transfer-runtime.mjs",
    "check:web-security": "tsx tests/contracts/tools/check-web-security-tools.mjs",
    "check:page-scripts": "tsx tests/contracts/runtime/check-page-scripts.mjs",
    "check:fake-ws": "tsx tests/contracts/runtime/check-fake-ws.mjs",
    "check:lifecycle": "tsx tests/contracts/runtime/check-lifecycle.mjs",
    "check:smoke-diagnostics": "node tests/contracts/runtime/check-smoke-diagnostics.mjs",
    "check:paths": "tsx tests/contracts/runtime/check-paths.mjs",
    "check:token": "tsx tests/contracts/tools/check-token-contract.mjs",
    "check:summaries": "tsx tests/contracts/tools/check-summaries.mjs",
    "check:artifact": "tsx tests/contracts/tools/check-artifact-reader.mjs",
    "check:errors": "tsx tests/contracts/tools/check-errors.mjs",
    "check:eval-workflows": "node tests/contracts/tools/check-eval-workflows.mjs",
    "eval:browser-workflows": "tsx evals/browser-workflows/runner.mjs",
    "eval:blind:launch": "node evals/browser-workflows/launch-blind.mjs",
    "eval:blind:teardown": "node evals/browser-workflows/teardown-blind.mjs",
    "check:browser-workflow-results": "node tests/contracts/tools/check-browser-workflow-results.mjs",
    "check:browser-commands": "node tests/contracts/runtime/check-browser-commands.mjs",
    "check:jshookmcp-closure": "node tests/contracts/tools/check-jshookmcp-closure.mjs",
    "check:distiller-coverage": "tsx tests/contracts/drift/check-distiller-coverage.mjs",
    "check:output-schema-conformance": "tsx tests/contracts/drift/check-output-schema-conformance.mjs",
    "check:tool-parameter-contract": "tsx tests/contracts/drift/check-tool-parameter-contract.mjs",
    "check:tool-parameter-framework-validation": "node tests/contracts/drift/check-tool-parameter-framework-validation.mjs",
    "check:cli-parity": "tsx tests/contracts/cli/check-cli-parity.mjs",
    "check:abml-ref-registry": "tsx tests/contracts/tools/check-abml-ref-registry.mjs",
    "check:abml-scan-entities": "tsx tests/contracts/tools/check-abml-scan-entities.mjs",
    "check:abml-scan-envelope": "tsx tests/contracts/tools/check-abml-scan-envelope.mjs",
    "check:abml-verb-runtime": "tsx tests/contracts/tools/check-abml-verb-runtime.mjs",
    "check:abml-ax-runtime": "tsx tests/contracts/tools/check-abml-ax-runtime.mjs",
    "check:abml-relation-graph": "tsx tests/contracts/tools/check-abml-relation-graph.mjs",
    "check:abml-stream-plane": "tsx tests/contracts/tools/check-abml-stream-plane.mjs",
    "check:abml-stream-runtime": "tsx tests/contracts/tools/check-abml-stream-runtime.mjs",
    "check:abml-p6p7-runtime": "tsx tests/contracts/tools/check-abml-p6p7-runtime.mjs",
    "check:abml-internal-integration": "tsx tests/contracts/tools/check-abml-internal-integration.mjs",
    "test:observe-abml-integration": "tsx --test tests/unit/tools/observe-abml-integration.test.ts",
    "check:memory-autosurface": "tsx tests/contracts/tools/check-memory-autosurface.mjs",
    "check:memory-lifecycle": "tsx tests/contracts/tools/check-memory-lifecycle.mjs",
    "check:token-economy": "tsx tests/contracts/tools/check-token-economy.mjs",
    "smoke:browser": "tsx tests/smoke/smoke-browser.mjs",
    "smoke:browser:transfer": "tsx tests/smoke/smoke-browser.mjs --transfer",
    "check": "npm run check:all",
    "quality:local": "npm run build:bridge && npm run check && npm pack --dry-run --json && node -e \"console.log('quality:local ok. Optional runtime smoke: npm run smoke:browser:isolated. Artifacts: .pi/browser-artifacts/. If bridge port range 18765-18784 is exhausted, inspect .pi/browser-artifacts/smoke-browser-results.json bridge.port and stop owners manually.')\"",
    "release:local": "node tests/release/release-local-acceptance.mjs",
    "release:local:smoke": "node tests/release/release-local-acceptance.mjs --smoke --rollback-smoke",
    "check:boundaries": "node tests/contracts/drift/check-boundaries.mjs",
    "check:abml-core-boundary": "node tests/contracts/drift/check-abml-core-boundary.mjs",
    "check:cli-migration-drift": "node tests/contracts/drift/check-cli-migration-drift.mjs",
    "smoke:browser:isolated": "tsx tests/smoke/smoke-browser-isolated.mjs",
    "smoke:browser:scan-summary": "tsx tests/smoke/smoke-scan-summary.mjs",
    "smoke:browser:debugger-evidence": "tsx tests/smoke/smoke-debugger-evidence.mjs",
    "smoke:browser:correlation-chain": "tsx tests/smoke/smoke-correlation-chain.mjs",
    "smoke:browser:abml-monitor-comparison": "tsx tests/smoke/smoke-abml-monitor-comparison.mjs",
    "smoke:browser:abml-frame-compare": "tsx tests/smoke/smoke-abml-frame-compare.mjs",
    "smoke:browser:abml-vision-compare": "tsx tests/smoke/smoke-abml-vision-compare.mjs",
    "smoke:browser:intercept-response": "tsx tests/smoke/smoke-intercept-response.mjs",
    "smoke:browser:intercept-replace-script": "tsx tests/smoke/smoke-intercept-replace-script.mjs",
    "smoke:browser:intercept-uninstall-fail-closed": "tsx tests/smoke/smoke-intercept-uninstall-fail-closed.mjs",
    "smoke:browser:intercept-request-mutate": "tsx tests/smoke/smoke-intercept-request-mutate.mjs",
    "smoke:browser:intercept-tab-close-cleanup": "tsx tests/smoke/smoke-intercept-tab-close-cleanup.mjs",
    "smoke:browser:intercept-lease-conflict": "tsx tests/smoke/smoke-intercept-lease-conflict.mjs",
    "smoke:browser:websocket-session": "tsx tests/smoke/smoke-websocket-session.mjs",
    "smoke:browser:ax-merge": "tsx tests/smoke/smoke-browser-ax-merge.mjs",
    "smoke:browser:abml-relations": "tsx tests/smoke/smoke-abml-relations.mjs",
    "smoke:browser:abml-causal": "tsx tests/smoke/smoke-abml-causal.mjs",
    "smoke:browser:abml-templating": "tsx tests/smoke/smoke-abml-templating.mjs",
    "smoke:browser:memory": "tsx tests/smoke/smoke-browser-memory.mjs",
    "smoke:abml:internal-routing": "tsx tests/smoke/smoke-abml-internal-tool-routing.mjs",
    "prepack": "npm run build && node scripts/build-bridge.mjs --quiet",
    "check:package": "node tests/contracts/drift/check-package-files.mjs",
    "check:deps": "node tests/contracts/drift/check-dependencies.mjs",
    "check:runtime-fixtures": "tsx tests/contracts/runtime/check-runtime-fixtures.mjs",
    "check:abml-ax-smoke": "tsx tests/contracts/runtime/check-abml-ax-smoke.mjs",
    "check:abml-inference": "tsx tests/contracts/tools/check-abml-inference.mjs",
    "check:abml-diff": "tsx tests/contracts/tools/check-abml-diff.mjs",
    "check:abml-causal": "tsx tests/contracts/tools/check-abml-causal.mjs",
    "check:abml-templating": "tsx tests/contracts/tools/check-abml-templating.mjs",
    "check:abml-tree-diff": "tsx tests/contracts/tools/check-abml-tree-diff.mjs",
    "check:abml-semantic-ref-anchor": "tsx tests/contracts/tools/check-abml-semantic-ref-anchor.mjs",
    "check:abml-snapshot-projection": "tsx tests/contracts/tools/check-abml-snapshot-projection.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "typebox": "^1.0.55",
    "typescript": "^6.0.3",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "^1.0.55"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.4",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "lefthook": "^1.13.6",
    "tsx": "^4.22.3",
    "typescript-eslint": "^8.60.0"
  },
  "files": [
    "AGENTS.md",
    "AI_INSTALL.md",
    "CHANGELOG.md",
    "README.md",
    "TODO.md",
    "CURRENT.md",
    "ARCHIVE.md",
    "ROADMAP.md",
    "WORKSTREAMS_A_E_SUMMARY.md",
    "bridge/",
    "bridge_src/",
    "docs/",
    "scripts/",
    "skills/",
    "cli/",
    "src/",
    "dist/",
    "tests/",
    "evals/",
    "tsconfig.json",
    "tsconfig.base.json",
    "tsconfig.build.json",
    "tsconfig.bridge-src.json",
    "lefthook.yml"
  ]
}
