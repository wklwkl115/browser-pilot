{
  "name": "pi-browser-tools",
  "version": "0.3.0",
  "private": true,
  "description": "Native Pi browser automation tools backed by the Pi Browser Bridge.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "browser-automation"
  ],
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "sync:protocol": "node scripts/sync-native-protocol.mjs",
    "sync:config": "node scripts/sync-bridge-config.mjs",
    "docs:generate": "node scripts/generate-tool-docs.mjs",
    "docs:sync-indexes": "node scripts/sync-doc-indexes.mjs",
    "build:bridge": "node scripts/build-bridge.mjs",
    "check:all": "node scripts/run-check-groups.mjs",
    "check:all:bridge": "node scripts/run-check-groups.mjs bridge unit",
    "check:src:types": "tsc -p tsconfig.json",
    "check:all:package": "node scripts/run-check-groups.mjs package docs",
    "check:all:contracts": "node scripts/run-check-groups.mjs contracts",
    "check:lint": "node tests/contracts/check-boundaries.mjs && node tests/contracts/check-bridge-files.mjs && node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/contracts/check-page-scripts.mjs",
    "verify:bridge:dist": "node tests/contracts/check-bridge-build.mjs",
    "check:bridge:files": "node tests/contracts/check-bridge-files.mjs",
    "check:bridge:build": "npm run verify:bridge:dist",
    "check:bridge:types": "tsc -p tsconfig.bridge-src.json",
    "check:protocol": "node scripts/sync-native-protocol.mjs --check && node tests/contracts/check-protocol-contract.mjs",
    "check:tools": "node tests/contracts/check-tools-contract.mjs && node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/contracts/check-execute-tool.mjs",
    "check:pi-browser-bridge": "node tests/contracts/check-pi-browser-bridge.mjs",
    "check:tool-docs": "node tests/contracts/check-tool-doc-drift.mjs && node scripts/generate-tool-docs.mjs --check",
    "check:doc-structure": "node tests/contracts/check-doc-structure.mjs",
    "test:unit": "node --test --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/unit/**/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/unit/**/*.test.ts",
    "check:bridge": "npm run check:bridge:types && npm run check:bridge:build && npm run check:bridge:files && npm run check:protocol && npm run check:tools",
    "check:registry-drift": "node tests/contracts/check-registry-drift.mjs",
    "check:scan": "node --no-warnings --experimental-strip-types tests/contracts/check-scan-script.mjs",
    "check:content-pick": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/contracts/check-content-pick.mjs",
    "check:transfer": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/contracts/check-transfer-tools.mjs && node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/contracts/check-transfer-runtime.mjs",
    "check:web-security": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/contracts/check-web-security-tools.mjs",
    "check:page-scripts": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/contracts/check-page-scripts.mjs",
    "check:fake-ws": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/contracts/check-fake-ws.mjs",
    "check:lifecycle": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/contracts/check-lifecycle.mjs",
    "check:smoke-diagnostics": "node tests/contracts/check-smoke-diagnostics.mjs",
    "check:paths": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/contracts/check-paths.mjs",
    "check:token": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/contracts/check-token-contract.mjs",
    "check:summaries": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/contracts/check-summaries.mjs",
    "check:artifact": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/contracts/check-artifact-reader.mjs",
    "check:errors": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/contracts/check-errors.mjs",
    "check:eval-workflows": "node tests/contracts/check-eval-workflows.mjs",
    "check:browser-workflow-results": "node tests/contracts/check-browser-workflow-results.mjs",
    "check:browser-commands": "node tests/contracts/check-browser-commands.mjs",
    "check:jshookmcp-closure": "node tests/contracts/check-jshookmcp-closure.mjs",
    "smoke:browser": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/smoke/smoke-browser.mjs",
    "smoke:browser:transfer": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/smoke/smoke-browser.mjs --transfer",
    "check": "npm run check:all",
    "quality:local": "npm run build:bridge && npm run check && npm pack --dry-run --json && node -e \"console.log('quality:local ok. Optional runtime smoke: npm run smoke:browser:isolated. Artifacts: .pi/browser-artifacts/. If bridge port range 18765-18784 is exhausted, inspect .pi/browser-artifacts/smoke-browser-results.json bridge.port and stop owners manually.')\"",
    "release:local": "node tests/release/release-local-acceptance.mjs",
    "release:local:smoke": "node tests/release/release-local-acceptance.mjs --smoke --rollback-smoke",
    "check:boundaries": "node tests/contracts/check-boundaries.mjs",
    "smoke:browser:isolated": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/smoke/smoke-browser-isolated.mjs",
    "smoke:browser:scan-summary": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/smoke/smoke-scan-summary.mjs",
    "smoke:browser:debugger-evidence": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/smoke/smoke-debugger-evidence.mjs",
    "smoke:browser:correlation-chain": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/smoke/smoke-correlation-chain.mjs",
    "smoke:browser:intercept-response": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/smoke/smoke-intercept-response.mjs",
    "smoke:browser:intercept-replace-script": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/smoke/smoke-intercept-replace-script.mjs",
    "smoke:browser:intercept-uninstall-fail-closed": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/smoke/smoke-intercept-uninstall-fail-closed.mjs",
    "smoke:browser:intercept-request-mutate": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/smoke/smoke-intercept-request-mutate.mjs",
    "smoke:browser:intercept-tab-close-cleanup": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/smoke/smoke-intercept-tab-close-cleanup.mjs",
    "smoke:browser:intercept-lease-conflict": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/smoke/smoke-intercept-lease-conflict.mjs",
    "smoke:browser:websocket-session": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/smoke/smoke-websocket-session.mjs",
    "prepack": "node scripts/build-bridge.mjs --quiet",
    "check:package": "node tests/contracts/check-package-files.mjs",
    "check:deps": "node tests/contracts/check-dependencies.mjs",
    "check:runtime-fixtures": "node --no-warnings --experimental-strip-types --import ./scripts/register-ts-extension-loader.mjs tests/contracts/check-runtime-fixtures.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "typescript": "^6.0.3",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "^1.0.55"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.4",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "typebox": "^1.0.55",
    "typescript": "^6.0.3"
  },
  "files": [
    "AGENTS.md",
    "AI_INSTALL.md",
    "CHANGELOG.md",
    "README.md",
    "TODO.md",
    "CURRENT.md",
    "ARCHIVE.md",
    "ROADMAP.md",
    "WORKSTREAMS_A_E_SUMMARY.md",
    "bridge/",
    "bridge_src/",
    "docs/",
    "scripts/",
    "src/",
    "tests/",
    "evals/",
    "tsconfig.json",
    "tsconfig.bridge-src.json"
  ]
}
