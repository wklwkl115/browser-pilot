{
  "name": "browser-pilot",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "description": "Agent-driven browser automation: a Chrome extension + Node bridge exposing composable browser_* tools for scanning, execution, and evidence capture.",
  "keywords": [
    "browser-pilot",
    "browser-automation",
    "chrome-extension",
    "cdp",
    "devtools-protocol",
    "web-scraping",
    "dom",
    "agent-tools",
    "ai-agent",
    "ai-tools",
    "browser-testing"
  ],
  "author": "Wang-ke-li",
  "homepage": "https://github.com/wklwkl115/browser-pilot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wklwkl115/browser-pilot.git"
  },
  "bugs": {
    "url": "https://github.com/wklwkl115/browser-pilot/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "browser-pilot-mcp": "./dist/src/apps/mcp/bin.js"
  },
  "scripts": {
    "sync:config": "node scripts/sync-bridge-config.mjs",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json",
    "build:bridge": "node scripts/build-bridge.mjs",
    "prepare": "tsc -p tsconfig.build.json && node scripts/build-bridge.mjs --quiet",
    "mcp": "tsx src/apps/mcp/bin.ts",
    "test": "node scripts/run-tests.mjs all",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:bridge": "tsc -p tsconfig.bridge-src.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run typecheck && npm run typecheck:bridge && npm run typecheck:tests && npm run lint && npm test && npm run build:bridge",
    "smoke:browser": "node --import tsx scripts/run-browser-smoke.mjs --quiet",
    "prepack": "npm run build && node scripts/build-bridge.mjs --quiet"
  },
  "dependencies": {
    "typebox": "^1.0.55",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.4",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "files": [
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "bridge/",
    "capture-src/",
    "scripts/build-bridge.mjs",
    "scripts/clean-build.mjs",
    "scripts/sync-bridge-config.mjs",
    "src/",
    "dist/",
    "tsconfig.json",
    "tsconfig.base.json",
    "tsconfig.build.json",
    "tsconfig.bridge-src.json"
  ]
}
